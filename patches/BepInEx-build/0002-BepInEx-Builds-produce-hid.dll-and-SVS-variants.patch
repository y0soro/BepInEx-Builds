From f5d96e6b89acf321ca3a6da9dd3c2c0a693ab6a8 Mon Sep 17 00:00:00 2001
From: y0soro <y0soro@protonmail.com>
Date: Fri, 8 May 2026 09:26:07 +0800
Subject: [PATCH 2/2] BepInEx-Builds: produce hid.dll and SVS variants

---
 build/TaskIllgamesFixes.cs | 74 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 74 insertions(+)
 create mode 100644 build/TaskIllgamesFixes.cs

diff --git a/build/TaskIllgamesFixes.cs b/build/TaskIllgamesFixes.cs
new file mode 100644
index 0000000..8c8e25a
--- /dev/null
+++ b/build/TaskIllgamesFixes.cs
@@ -0,0 +1,74 @@
+#pragma warning disable CS1591
+// ReSharper disable ClassNeverInstantiated.Global
+using System.Linq;
+using Cake.Common;
+using Cake.Common.IO;
+using Cake.Core.Diagnostics;
+using Cake.Core.IO;
+using Cake.Frosting;
+
+[TaskName("PublishIllgamesFixes")]
+[IsDependentOn(typeof(MakeDistTask))]
+[IsDependentOn(typeof(PushNuGetTask))]
+public sealed class PublishIllgamesFixesTask : FrostingTask<BuildContext>
+{
+    public override void Run(BuildContext ctx)
+    {
+        ctx.Log.Information("Packing BepInEx");
+
+        foreach (var dist in ctx.Distributions)
+        {
+            var targetZipName = $"BepInEx-illgames-default-{dist.Target}-{ctx.BuildPackageVersion}.zip";
+            ctx.Log.Information($"Packing {targetZipName}");
+
+            var distDir = ctx.DistributionDirectory.Combine(dist.Target);
+
+            if (dist.Target == "Unity.IL2CPP-win-x64")
+            {
+                var doorstopBuildEnv = ctx.EnvironmentVariable("BEPINEX_BUILDS_DOORSTOP");
+                var doorstopBuild =
+                    doorstopBuildEnv != null
+                        ? new DirectoryPath(doorstopBuildEnv)
+                        : ctx.RootDirectory.Combine("../UnityDoorstop/build/mingw/x86_64/release");
+
+                var metadataDirEnv = ctx.EnvironmentVariable("BEPINEX_BUILDS_METADATA");
+                var metadataDir =
+                    metadataDirEnv != null
+                        ? new DirectoryPath(metadataDirEnv)
+                        : ctx.RootDirectory.Combine("../../metadata-index");
+
+                ctx.Zip(distDir, ctx.DistributionDirectory.CombineWithFilePath(targetZipName));
+
+                //
+                // produce variant that uses hid.dll
+                //
+
+                targetZipName = $"BepInEx-illgames-hid.dll-{dist.Target}-{ctx.BuildPackageVersion}.zip";
+
+                ctx.DeleteFile(distDir.CombineWithFilePath("winhttp.dll"));
+
+                ctx.CopyFileToDirectory(doorstopBuild.CombineWithFilePath(".doorstop_version"), distDir);
+                ctx.CopyFile(
+                    doorstopBuild.CombineWithFilePath("libdoorstop.dll"),
+                    distDir.CombineWithFilePath("hid.dll")
+                );
+
+                ctx.Zip(distDir, ctx.DistributionDirectory.CombineWithFilePath(targetZipName));
+
+                //
+                // produce SVS variant that uses hid.dll and contains decrypted metadata
+                //
+
+                var svsZipName = $"BepInEx-SVS-hid.dll-{dist.Target}-{ctx.BuildPackageVersion}.zip";
+
+                ctx.CopyDirectory(metadataDir, distDir.Combine("BepInEx/metadata-index"));
+
+                ctx.Zip(distDir, ctx.DistributionDirectory.CombineWithFilePath(svsZipName));
+            }
+            else
+            {
+                ctx.Zip(distDir, ctx.DistributionDirectory.CombineWithFilePath(targetZipName));
+            }
+        }
+    }
+}
